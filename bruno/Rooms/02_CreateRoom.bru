meta {
  name: Create Room
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Rooms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "English Practice",
    "description": "Casual English conversation",
    "languageCode": "en",
    "type": "Audio",
    "maxParticipants": 6
  }
}

docs {
  type: "Audio" | "Video" | "Text"
  maxParticipants: 2–50
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("roomId", res.body);
  }
}
