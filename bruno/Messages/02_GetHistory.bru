meta {
  name: Get DM History
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Social/conversations/{{conversationId}}/messages?pageSize=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Returns paginated message history in the conversation specified by conversationId.
}
