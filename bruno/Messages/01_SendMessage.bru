meta {
  name: Send Message (DM)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Social/dm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "recipientId": "{{targetUserId}}",
    "content": "Hey! Want to practice together?"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("conversationId", res.body.conversationId);
  }
}

docs {
  Sends a direct message to the user specified by targetUserId.
  Saves the conversationId from the response.
}
