meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "Test@1234!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("userId", res.body.userId);
  }
}
