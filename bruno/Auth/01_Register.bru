meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "Test@1234!"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("userId", res.body.userId);
  }
}
